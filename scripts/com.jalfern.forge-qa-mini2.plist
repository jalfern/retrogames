<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- QA·MINI·2 (#2280): the mini's second QA slot. Same oMLX stream (:18000
     tunnel) as com.jalfern.forge-qa, its own session identity
     ("QA MASTER on node mini2."), dev port 5179 and tap — the two lanes never
     block each other; qa-claim.sh's unified namespace settles collisions at
     claim time (#878). Shared inference is Jon's accepted trade-off.
     Install: launchctl bootstrap gui/$UID scripts/com.jalfern.forge-qa-mini2.plist
     (after merge; forge-qa.sh must know the mini2 node before this may run). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jalfern.forge-qa-mini2</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>git -C /Users/jon/Dev/retrogames fetch -q origin main 2>/dev/null; git -C /Users/jon/Dev/retrogames show origin/main:scripts/forge-qa.sh | exec /bin/zsh -s -- "$@"</string>
        <string>forge-qa.sh</string>
        <string>--foreground</string>
        <string>mini2</string>
    </array>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/forge/qa-mini2-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/forge/qa-mini2-launchd.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <key>HOME</key>
        <string>/Users/jon</string>
    </dict>
</dict>
</plist>
