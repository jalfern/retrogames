<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TAP for QA·MINI·2 (#2280): :8014 -> the Mac mini's oMLX through the :18000
     tunnel (same upstream as tap-mini — shared inference, separate stream log),
     copying streamed tokens to /tmp/forge/stream-mini2.log for `watch.sh --live`.
     KeepAlive restarts it within a second if it ever exits. See scripts/tap.mjs.
     Install: forge-qa.sh bootstraps this from origin/main (merge = install,
     the tap-studio pattern). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jalfern.tap-mini2</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/jon/Dev/retrogames/scripts/tap.mjs</string>
        <string>--listen</string>
        <string>8014</string>
        <string>--upstream</string>
        <string>18000</string>
        <string>--out</string>
        <string>/tmp/forge/stream-mini2.log</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>1</integer>
    <key>StandardOutPath</key>
    <string>/tmp/forge/tap-mini2.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/forge/tap-mini2.err</string>
</dict>
</plist>
